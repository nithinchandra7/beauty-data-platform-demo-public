  "components": {
    "schemas": {
      "BeautyQuestion": {
        "properties": {
          "question": {
            "type": "string",
            "maxLength": 300,
            "minLength": 1,
            "title": "Question"
          },
          "metric": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "net_revenue",
                  "margin_pct",
                  "discount_pct",
                  "cash_collected",
                  "receivables",
                  "overdue"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Metric"
          },
          "market": {
            "type": "string",
            "enum": [
              "all",
              "US",
              "GB",
              "CA"
            ],
            "title": "Market",
            "default": "all"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "question"
        ],
        "title": "BeautyQuestion"
      },
      "BeautyStart": {
        "properties": {
          "scenario": {
            "type": "string",
            "enum": [
              "clean",
              "bad_batch",
              "duplicate",
              "currency"
            ],
            "title": "Scenario",
            "default": "clean"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "BeautyStart"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
